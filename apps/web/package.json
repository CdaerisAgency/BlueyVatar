{
  "name": "@blueyvatar/web",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-embed.mjs && next dev",
    "build": "node scripts/build-embed.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "gen-jwk": "node --experimental-strip-types scripts/gen-jwk.ts",
    "test": "vitest run",
    "build:embed": "node scripts/build-embed.mjs",
    "a11y": "node scripts/build-embed.mjs && node a11y/hovercards.mjs && node a11y/axe.mjs",
    "a11y:hovercards": "node scripts/build-embed.mjs && node a11y/hovercards.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@atproto/jwk-jose": "0.2.4",
    "@atproto/oauth-client-node": "0.5.13",
    "@blueyvatar/avatar": "workspace:*",
    "@blueyvatar/core": "workspace:*",
    "@blueyvatar/hovercards": "workspace:*",
    "@tailwindcss/postcss": "4.3.5",
    "next": "16.4.4",
    "pg": "8.23.1",
    "postcss": "8.5.32",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stripe": "23.1.0",
    "tailwindcss": "4.3.5",
    "tldts": "7.4.19"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "vitest": "3.2.7"
  }
}
