{
  "name": "@blueyvatar/web",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-embed.mjs && node scripts/build-docs.mjs && next dev",
    "build": "node scripts/build-embed.mjs && node scripts/build-docs.mjs && next build",
    "start": "next start",
    "typecheck": "node scripts/build-docs.mjs && tsc --noEmit",
    "gen-jwk": "node --experimental-strip-types scripts/gen-jwk.ts",
    "test": "node scripts/build-docs.mjs && vitest run",
    "build:embed": "node scripts/build-embed.mjs",
    "build:docs": "node scripts/build-docs.mjs"
  },
  "dependencies": {
    "@atproto/jwk-jose": "0.2.4",
    "@atproto/oauth-client-node": "0.5.13",
    "@blueyvatar/core": "workspace:*",
    "@blueyvatar/hovercards": "workspace:*",
    "@tailwindcss/postcss": "4.3.5",
    "marked": "18.1.3",
    "next": "16.4.4",
    "pg": "8.23.1",
    "postcss": "8.5.32",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stripe": "23.1.0",
    "tailwindcss": "4.3.5",
    "tldts": "7.4.19"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "vitest": "3.2.7"
  }
}
