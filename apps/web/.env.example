# Variables read only by apps/web. Shared ones (DATABASE_URL, PUBLIC_URL, TAP_URL, ORIGIN_SECRET, TOKEN_ENCRYPTION_KEY,
# CF_ZONE_ID, CF_API_TOKEN, PLUS_DIDS, RESEND_API_KEY, EMAIL_FROM, SENTRY_*, METRICS_TOKEN) are in the root .env.example.

# Base URL of the delivery API.
DELIVERY_URL=http://localhost:3001

# Session cookie signing secret (required in production; from Infisical).
SESSION_SECRET=
# Trusted PDS hosts for direct email linking (comma list). Empty means every link uses the mailed code.
TRUSTED_PDS_HOSTS=
# OAuth private JWK (from Infisical; generate with pnpm --filter @blueyvatar/web gen-jwk).
OAUTH_PRIVATE_JWK=
# Set to true to request the published permission set (include:com.blueyvatar.authFull) in place
# of the three repo: scopes. Leave unset until the lexicons are published (docs/deploy/lexicons-v1.md).
OAUTH_USE_PERMISSION_SET=
# Turns on the Integrations page's per-app avatar push and declares its profile scopes in the OAuth client metadata.
# Leave empty until tested on staging (docs/deploy/avatar-push-permission-v1.md).
OAUTH_PUSH_APPS=
# Size of the small Postgres pool that holds OAuth request locks (default 4). Separate from PG_POOL_MAX.
# OAUTH_LOCK_POOL_MAX=4

# Custom profile domains (Plus plan, Cloudflare for SaaS). The feature shows
# "not available yet" until the zone ID and token are set. The token needs the
# SSL and Certificates edit permission on the SaaS zone (Infisical secrets).
CF_SAAS_ZONE_ID=
CF_SAAS_API_TOKEN=
# CNAME target customers point their subdomain at, for example profiles.blueyvatar.com.
CF_SAAS_FALLBACK_ORIGIN=

# Verified accounts (issues #28 and #51). GitHub OAuth app, scope read:user. The callback URL is
# PUBLIC_URL/account/claims/callback. Leave unset to disable GitHub verification.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# More verified-account providers (issue #58, docs/research/verified-accounts-v1.md). Each is off until its
# VERIFY_*_ENABLED flag is exactly "true" AND both credentials are set. Leave the flag unset until the platform's
# app review is done. The callback URL for every provider is PUBLIC_URL/account/claims/callback. Values live in
# Infisical; never commit them. Domain (DNS TXT) and Bluesky proofs need no keys.
VERIFY_INSTAGRAM_ENABLED=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
VERIFY_THREADS_ENABLED=
THREADS_APP_ID=
THREADS_APP_SECRET=
VERIFY_TIKTOK_ENABLED=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
VERIFY_YOUTUBE_ENABLED=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VERIFY_TWITCH_ENABLED=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Stripe billing (issue #67). Billing is off, and says so, until all four are set. Values live in Infisical; never commit them.
# Secret API key (restricted key recommended: Checkout Sessions, Customer Portal, Customers write).
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint https://blueyvatar.com/api/stripe/webhook (starts with whsec_).
STRIPE_WEBHOOK_SECRET=
# Price ids (price_...) of the $9 per month Plus and $49 per month Business prices.
# STRIPE_PRICE_PLUS may list retired Plus or Pro price ids after the first one, comma separated;
# they map to Plus for existing subscribers and are never sold.
STRIPE_PRICE_PLUS=
STRIPE_PRICE_BUSINESS=

# Upload screening. Off unless both are set. SCAN_FAIL_CLOSED=1 also blocks uploads when the service is down.
PHOTODNA_ENDPOINT=
PHOTODNA_KEY=
SCAN_FAIL_CLOSED=

# Bug report button (issue 266). The button files a GitHub issue on the server.
# GITHUB_FEEDBACK_TOKEN is a secret: a fine-grained personal access token with Issues: Read and write on the
# one repository below and nothing else. Leave it unset to hide the button and refuse reports (docs/deploy/bug-reports-v1.md).
GITHUB_FEEDBACK_TOKEN=
# Repository the issues are filed in, as owner/name. Defaults to CdaerisAgency/BlueyVatar.
GITHUB_FEEDBACK_REPO=
