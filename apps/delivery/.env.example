# Variables read only by apps/delivery. Shared ones (DATABASE_URL, PUBLIC_URL, ORIGIN_SECRET,
# IMG_SIGNING_SECRET, WARM_SECRET, PG_POOL_MAX, SENTRY_*, LOG_LEVEL, METRICS_TOKEN) are in the root .env.example.

# Listen port.
PORT=3001

# Comma-separated hosts allowed as a custom `d=` default image URL.
DEFAULT_URL_ALLOWLIST=

# Set to true only when Cloudflare sits in front of delivery, so the client IP is read from CF-Connecting-IP.
TRUST_CLOUDFLARE=false

# Log retention. Logs are kept 90 days or until the size cap, whichever comes first.
# LOG_RETENTION_DAYS=90
# LOG_RETENTION_MAX_GB=5
