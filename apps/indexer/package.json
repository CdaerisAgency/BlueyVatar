{
  "name": "@blueyvatar/indexer",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run --passWithNoTests",
    "ops:block": "tsc -p tsconfig.json && node dist/ops-block.js block",
    "ops:block-did": "tsc -p tsconfig.json && node dist/ops-block.js block-did",
    "ops:unblock": "tsc -p tsconfig.json && node dist/ops-block.js unblock"
  },
  "dependencies": {
    "@atproto/tap": "0.4.17",
    "@blueyvatar/core": "workspace:*",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
