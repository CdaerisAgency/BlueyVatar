{
  "name": "@blueyvatar/indexer",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run --passWithNoTests",
    "test:tap-live": "vitest run src/tap-live.test.ts",
    "ops:block": "tsc -p tsconfig.json && node dist/ops-block.js block",
    "ops:block-did": "tsc -p tsconfig.json && node dist/ops-block.js block-did",
    "ops:unblock": "tsc -p tsconfig.json && node dist/ops-block.js unblock"
  },
  "dependencies": {
    "@atproto/common": "0.8.10",
    "@atproto/identity": "0.5.23",
    "@atproto/tap": "0.4.20",
    "@blueyvatar/core": "workspace:*",
    "pg": "8.23.1",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "@types/ws": "^8.18.2"
  }
}
