# Variables read only by apps/indexer. Shared ones (DATABASE_URL, TAP_URL, TAP_ADMIN_PASSWORD, PUBLIC_DELIVERY_URL,
# IMG_SIGNING_SECRET, WARM_SECRET, CF_ZONE_ID, CF_API_TOKEN, PG_POOL_MAX, SENTRY_*) are in the root .env.example.

# Cache warming (docs/deploy/cdn-warming-v1.md). All optional.
# WARM_SIZES=80,128,256,512
# WARM_FORMATS=png
# WARM_CONCURRENCY=2
# WARM_MAX_PER_MINUTE=120

# Optional: "prefix" purges whole /img/{did}/{cid}/ prefixes (Free plan: 5 requests
# per minute). Default "files" purges the known size ladder by URL.
CF_PURGE_MODE=

# Comma separated labeler DIDs whose moderation labels are enforced. Empty means off.
LABELER_DIDS=

# Fail /readyz when no Tap event or Tap health answer arrived for this many seconds (default 300).
INDEXER_STALL_SECONDS=
# Seconds between Tap health probes (default 15) and the internal health port (default 8080).
TAP_PROBE_INTERVAL_SECONDS=
HEALTH_PORT=

# Service repo that holds com.blueyvatar.attestation records (from Infisical). When either is unset,
# attestations are stored in Postgres only and no record is written to a repo.
SERVICE_REPO_DID=
SERVICE_APP_PASSWORD=
# PDS of the service account (default https://bsky.social).
SERVICE_PDS_URL=
