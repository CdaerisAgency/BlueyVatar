# blueyvatar environment variables. Copy to .env for local development.
# Real values for staging and production live in Infisical. Never commit secrets.

# Postgres connection string (secret). Leave unset to run delivery and the
# indexer with in-memory stores. Run `pnpm db:migrate` before first use.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/blueyvatar

# Direct (non-pooled) Postgres connection string, used only by migrations. On Neon,
# DATABASE_URL is the pooled (-pooler) endpoint for the apps and this is the direct one.
# Migrations use MIGRATE_DATABASE_URL, then DATABASE_URL_DIRECT, then DATABASE_URL.
DATABASE_URL_DIRECT=

# Optional: a Postgres database for the integration tests (they skip when unset).
# Each test run creates and drops its own schema.
TEST_DATABASE_URL=

# Tap sync service used by the indexer.
TAP_URL=http://localhost:2480
# Tap admin password (secret).
TAP_ADMIN_PASSWORD=

# Public base URL of the web app. Also the origin of the OAuth client ID
# (PUBLIC_URL/oauth-client-metadata.json).
PUBLIC_URL=http://localhost:3000

# Base URL of the delivery API, used by the web app.
DELIVERY_URL=http://localhost:3001

# Comma-separated hosts allowed as a custom `d=` default image URL.
DEFAULT_URL_ALLOWLIST=

# Set to true only when Cloudflare sits in front of the delivery API, so the
# client IP is read from CF-Connecting-IP.
TRUST_CLOUDFLARE=false
# Shared secret for origin lockdown. When set, delivery requires header x-origin-auth
# with this value on every request except GET /healthz (403 origin_forbidden otherwise).
# Add the same header via a Cloudflare request header transform rule (docs/deploy.md).
ORIGIN_SECRET=
# The web app also reads ORIGIN_SECRET: it trusts CF-Connecting-IP for rate limits only on requests
# carrying x-origin-auth with this value (docs/deploy.md, Web rate limits).

# HMAC secret that signs /img paths (secret; generate with `openssl rand -hex 32`). The
# redirect routes sign the image path and /img refuses unsigned or altered paths (403
# invalid_signature). The indexer needs the same value to warm and purge /img URLs.
# Delivery falls back to a random per-process value with a warning when unset.
IMG_SIGNING_SECRET=

# Delivery API listen port.
PORT=3001

# Optional: Postgres pool size per process (delivery defaults to 10, indexer to 5).
PG_POOL_MAX=

# Log retention (delivery). Logs are kept 90 days or until the size cap, whichever comes first.
# LOG_RETENTION_DAYS=90
# LOG_RETENTION_MAX_GB=5

# Public origin of the delivery API behind Cloudflare. The indexer uses it to warm
# and purge /img URLs. Warming is skipped and purges are logged only when unset.
PUBLIC_DELIVERY_URL=

# CDN cache warming (docs/deploy.md). WARM_SECRET must match on delivery and indexer so warm
# requests (x-warm-auth) skip usage meters. The rest are optional indexer settings.
WARM_SECRET=
# WARM_SIZES=80,128,256,512
# WARM_FORMATS=png
# WARM_CONCURRENCY=2
# WARM_MAX_PER_MINUTE=120

# Cloudflare cache purge for the indexer (Infisical secrets). Purges are logged
# only when either is unset. API token needs the Cache Purge permission.
CF_ZONE_ID=
CF_API_TOKEN=
# Optional: "prefix" purges whole /img/{did}/{cid}/ prefixes (Free plan: 5 requests
# per minute). Default "files" purges the known size ladder by URL.
CF_PURGE_MODE=

# Optional: override the migrations directory used by `pnpm db:migrate`.
MIGRATIONS_DIR=

# Web session cookie signing secret (required in production; from Infisical)
SESSION_SECRET=
# Encrypts OAuth tokens in Postgres (AES-256-GCM). 32 bytes, base64 or hex: openssl rand -base64 32.
# Required in production (web refuses to start without it); development uses a fixed key with a warning.
TOKEN_ENCRYPTION_KEY=
# Trusted PDS hosts for direct email linking (comma list)
TRUSTED_PDS_HOSTS=
# OAuth private JWK (from Infisical; generate with pnpm --filter @blueyvatar/web gen-jwk)
OAUTH_PRIVATE_JWK=
# Set to true to request the published permission set (include:com.blueyvatar.authFull) in place
# of the three repo: scopes. Leave unset until the lexicons are published (docs/deploy.md).
OAUTH_USE_PERMISSION_SET=
# Email sender for one-time codes (from Infisical); console fallback when unset
RESEND_API_KEY=
EMAIL_FROM="blueyvatar <aifashiontribute@gmail.com>"

# Custom profile domains (Plus plan, Cloudflare for SaaS). The feature shows
# "not available yet" until the zone ID and token are set. The token needs the
# SSL and Certificates edit permission on the SaaS zone (Infisical secrets).
CF_SAAS_ZONE_ID=
CF_SAAS_API_TOKEN=
# CNAME target customers point their subdomain at, for example profiles.blueyvatar.com.
CF_SAAS_FALLBACK_ORIGIN=
# Manual Plus grants: comma-separated DIDs treated as Plus without a subscription (testing, gifts).
# Paid Plus comes from a Stripe subscription (STRIPE_PRICE_PLUS) and needs no entry here.
PLUS_DIDS=
# Verified accounts (issues #28 and #51). GitHub OAuth app, scope read:user. The callback URL is
# PUBLIC_URL/account/claims/callback. Leave unset to disable GitHub verification.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# More verified-account providers (issue #58, docs/research/verified-accounts-v1.md). Each is off until its
# VERIFY_*_ENABLED flag is exactly "true" AND both credentials are set. Leave the flag unset until the platform's
# app review is done. The callback URL for every provider is PUBLIC_URL/account/claims/callback. Values live in
# Infisical; never commit them. Domain (DNS TXT) and Bluesky proofs need no keys.
VERIFY_INSTAGRAM_ENABLED=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
VERIFY_THREADS_ENABLED=
THREADS_APP_ID=
THREADS_APP_SECRET=
VERIFY_TIKTOK_ENABLED=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
VERIFY_YOUTUBE_ENABLED=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VERIFY_TWITCH_ENABLED=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Service repo that holds com.blueyvatar.attestation records (from Infisical). When either is unset,
# attestations are stored in Postgres only and no record is written to a repo.
SERVICE_REPO_DID=
SERVICE_APP_PASSWORD=
# PDS of the service account (default https://bsky.social).
SERVICE_PDS_URL=

# Lexicon publishing (tools/lexicon, docs/deploy.md). Export these in your shell at deploy time,
# never store values here. LEXICON_PUBLISH_DID and LEXICON_PUBLISH_PDS_URL are for the verify command.
# LEXICON_PUBLISH_IDENTIFIER=
# LEXICON_PUBLISH_APP_PASSWORD=
# LEXICON_PUBLISH_SERVICE=
# LEXICON_PUBLISH_DID=
# LEXICON_PUBLISH_PDS_URL=

# Stripe billing (issue #67). Billing is off, and says so, until all four are set. Values live in Infisical; never commit them.
# Secret API key (restricted key recommended: Checkout Sessions, Customer Portal, Customers write).
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint https://blueyvatar.com/api/stripe/webhook (starts with whsec_).
STRIPE_WEBHOOK_SECRET=
# Price ids (price_...) of the $9 per month Pro, $49 per month Business, and $9.99 per month Plus prices.
# STRIPE_PRICE_PLUS is optional: leave it empty and Plus is not sold.
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_PLUS=

# Observability (issue #143, docs/deploy.md "Observability"). All optional.
# Sentry-compatible DSN (Sentry, GlitchTip, or self-hosted). Error tracking is off when unset.
# Secret in production: set with `fly secrets set` from Infisical, never commit a real value.
SENTRY_DSN=
# Optional tags on error events. SENTRY_RELEASE defaults to FLY_IMAGE_REF, SENTRY_ENVIRONMENT to FLY_APP_NAME.
SENTRY_RELEASE=
SENTRY_ENVIRONMENT=
# Log level: debug, info, warn, or error (default info). Logs are one JSON object per line.
LOG_LEVEL=
# Bearer token for GET /metrics on delivery and GET /api/metrics on web (Prometheus text format).
# The routes answer 404 when it is unset. The indexer serves /metrics on its internal port 8080 without a token.
METRICS_TOKEN=
# Time budget for the Postgres readiness check (delivery /readyz, web /api/health), in milliseconds. Default 3000.
READY_TIMEOUT_MS=
# Indexer: fail /readyz when no Tap event or Tap health answer arrived for this many seconds (default 300).
INDEXER_STALL_SECONDS=
# Indexer: seconds between Tap health probes (default 15) and the internal health port (default 8080).
TAP_PROBE_INTERVAL_SECONDS=
HEALTH_PORT=
