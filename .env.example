# blueyvatar environment variables. Copy to .env for local development.
# Real values for staging and production live in Infisical. Never commit secrets.

# Postgres connection string (secret). Leave unset to run delivery and the
# indexer with in-memory stores. Run `pnpm db:migrate` before first use.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/blueyvatar

# Optional: a Postgres database for the integration tests (they skip when unset).
# Each test run creates and drops its own schema.
TEST_DATABASE_URL=

# Tap sync service used by the indexer.
TAP_URL=http://localhost:2480
# Tap admin password (secret).
TAP_ADMIN_PASSWORD=

# Public base URL of the web app. Also the origin of the OAuth client ID
# (PUBLIC_URL/oauth-client-metadata.json).
PUBLIC_URL=http://localhost:3000

# Base URL of the delivery API, used by the web app.
DELIVERY_URL=http://localhost:3001

# Comma-separated hosts allowed as a custom `d=` default image URL.
DEFAULT_URL_ALLOWLIST=

# Set to true only when Cloudflare sits in front of the delivery API, so the
# client IP is read from CF-Connecting-IP.
TRUST_CLOUDFLARE=false
# Shared secret for origin lockdown. When set, delivery requires header x-origin-auth
# with this value on every request except GET /healthz (403 origin_forbidden otherwise).
# Add the same header via a Cloudflare request header transform rule (docs/deploy.md).
ORIGIN_SECRET=

# Delivery API listen port.
PORT=3001

# Optional: Postgres pool size per process (delivery defaults to 10, indexer to 5).
PG_POOL_MAX=

# Public origin of the delivery API behind Cloudflare. The indexer uses it to warm
# and purge /img URLs. Warming is skipped and purges are logged only when unset.
PUBLIC_DELIVERY_URL=

# Cloudflare cache purge for the indexer (Infisical secrets). Purges are logged
# only when either is unset. API token needs the Cache Purge permission.
CF_ZONE_ID=
CF_API_TOKEN=
# Optional: "prefix" purges whole /img/{did}/{cid}/ prefixes (Free plan: 5 requests
# per minute). Default "files" purges the known size ladder by URL.
CF_PURGE_MODE=

# Optional: override the migrations directory used by `pnpm db:migrate`.
MIGRATIONS_DIR=

# Web session cookie signing secret (required in production; from Infisical)
SESSION_SECRET=
# Trusted PDS hosts for direct email linking (comma list)
TRUSTED_PDS_HOSTS=
# OAuth private JWK (from Infisical; generate with pnpm --filter @blueyvatar/web gen-jwk)
OAUTH_PRIVATE_JWK=
# Email sender for one-time codes (from Infisical); console fallback when unset
RESEND_API_KEY=
EMAIL_FROM="blueyvatar <aifashiontribute@gmail.com>"
