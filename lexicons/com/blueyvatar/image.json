{
  "lexicon": 1,
  "id": "com.blueyvatar.image",
  "defs": {
    "main": {
      "type": "record",
      "description": "One image. By default an avatar; see purpose for gallery images. The blob limits match app.bsky.actor.profile#avatar so one file works in both places.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["image", "createdAt"],
        "properties": {
          "image": { "type": "blob", "accept": ["image/png", "image/jpeg"], "maxSize": 1000000 },
          "alt": { "type": "string", "maxGraphemes": 300, "maxLength": 3000 },
          "labels": { "type": "union", "refs": ["com.atproto.label.defs#selfLabels"] },
          "license": {
            "type": "string",
            "description": "User-declared usage license. Values are placeholders until legal review.",
            "knownValues": ["personal", "cc-by", "cc-by-nc", "all-rights-reserved"]
          },
          "isDefault": { "type": "boolean" },
          "purpose": {
            "type": "string",
            "description": "What the image is for. A missing value means avatar. Gallery images never resolve as an avatar.",
            "knownValues": ["avatar", "gallery"],
            "maxLength": 32
          },
          "caption": { "type": "string", "maxGraphemes": 140, "maxLength": 1400, "description": "Gallery caption." },
          "sort": { "type": "integer", "description": "Gallery order, lowest first. Images without a value follow, newest first." },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
