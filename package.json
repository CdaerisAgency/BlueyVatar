{
  "name": "blueyvatar",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lex:install": "lex install --lexicons ./lexicons/vendor",
    "lex:build": "lex build --lexicons ./lexicons --out ./packages/core/src/lexicons --clear"
  },
  "devDependencies": {
    "@atproto/lex": "0.4.4",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
