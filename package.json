{
  "name": "blueyvatar",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:libs": "pnpm --filter @blueyvatar/core build && pnpm --filter @blueyvatar/hovercards build && pnpm --filter @blueyvatar/avatar build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "changelog:fold": "node tools/changelog/fold.mjs",
    "tap:live": "bash tools/tap-live.sh",
    "tap:live:local": "bash tools/tap-live-local.sh",
    "smoke": "node --experimental-strip-types tools/smoke/smoke.ts",
    "e2e": "pnpm --filter @blueyvatar/web e2e",
    "db:migrate": "pnpm --filter @blueyvatar/migrate migrate",
    "lex:install": "lex install --lexicons ./lexicons/vendor",
    "lex:build": "lex build --lexicons ./lexicons --out ./packages/core/src/lexicons --clear",
    "ops:block": "pnpm --filter @blueyvatar/indexer ops:block",
    "ops:block-did": "pnpm --filter @blueyvatar/indexer ops:block-did",
    "ops:unblock": "pnpm --filter @blueyvatar/indexer ops:unblock",
    "lexicons:validate": "pnpm --filter @blueyvatar/lexicon-tools validate",
    "lexicons:dry-run": "pnpm --filter @blueyvatar/lexicon-tools dry-run",
    "lexicons:publish": "pnpm --filter @blueyvatar/lexicon-tools publish-schemas",
    "lexicons:verify": "pnpm --filter @blueyvatar/lexicon-tools verify"
  },
  "devDependencies": {
    "@atproto/lex": "0.4.4",
    "@types/node": "26.6.7",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "minimatch@<11.0.1": "^11.0.1"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
