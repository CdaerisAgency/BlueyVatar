{
  "name": "blueyvatar",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "tap:live": "bash tools/tap-live.sh",
    "db:migrate": "pnpm --filter @blueyvatar/migrate migrate",
    "lex:install": "lex install --lexicons ./lexicons/vendor",
    "lex:build": "lex build --lexicons ./lexicons --out ./packages/core/src/lexicons --clear",
    "ops:block": "pnpm --filter @blueyvatar/indexer ops:block",
    "ops:block-did": "pnpm --filter @blueyvatar/indexer ops:block-did",
    "ops:unblock": "pnpm --filter @blueyvatar/indexer ops:unblock",
    "lexicons:validate": "pnpm --filter @blueyvatar/lexicon-tools validate",
    "lexicons:dry-run": "pnpm --filter @blueyvatar/lexicon-tools dry-run",
    "lexicons:publish": "pnpm --filter @blueyvatar/lexicon-tools publish-schemas",
    "lexicons:verify": "pnpm --filter @blueyvatar/lexicon-tools verify"
  },
  "devDependencies": {
    "@atproto/lex": "0.4.4",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
