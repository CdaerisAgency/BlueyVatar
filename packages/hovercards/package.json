{
  "name": "@blueyvatar/hovercards",
  "version": "0.1.0",
  "private": false,
  "description": "Embeddable blueyvatar hovercards. Requires a Plus, Business, or Enterprise publishable key.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./auto": { "types": "./dist/auto.d.ts", "default": "./dist/auto.js" }
  },
  "sideEffects": ["./dist/auto.js"],
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "vitest": "3.2.7"
  }
}
