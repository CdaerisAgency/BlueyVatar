{
  "name": "@blueyvatar/avatar",
  "version": "0.1.0",
  "private": false,
  "description": "Avatar URL builder, email hashing, Gravatar migration helper, and React component for BlueyVatar.",
  "keywords": [
    "avatar",
    "blueyvatar",
    "gravatar",
    "atproto",
    "bluesky",
    "react",
    "identicon"
  ],
  "license": "AGPL-3.0-only",
  "homepage": "https://blueyvatar.com/docs",
  "bugs": {
    "url": "https://github.com/CdaerisAgency/BlueyVatar/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CdaerisAgency/BlueyVatar.git",
    "directory": "packages/avatar"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "@types/react-dom": "19.3.0",
    "vitest": "5.1.1"
  }
}
