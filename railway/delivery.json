{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": ["/apps/delivery/**", "/packages/core/**", "/db/**", "/tools/migrate/**", "/Dockerfile"]
  },
  "deploy": {
    "startCommand": "node apps/delivery/dist/server.js",
    "preDeployCommand": "node tools/migrate/dist/cli.js",
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
